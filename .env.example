# Copy to .env for local development:  cp .env.example .env
#
# The service FAILS TO START if any required variable is missing or invalid
# (Spec.md §8). There are deliberately no defaults for secrets.

# --- Required ---------------------------------------------------------------
ENVIRONMENT=local

# Postgres — system of record. The `postgresql://` scheme DigitalOcean hands
# out is rewritten to `postgresql+asyncpg://` automatically (app/core/config.py).
DATABASE_URL=postgresql+asyncpg://leaderboard:leaderboard@localhost:5432/leaderboard

# Shared key for score submission. Minimum 16 chars; obvious placeholders are
# rejected at startup. Generate one with:  openssl rand -hex 32
API_KEY=local-dev-api-key-not-for-production
# Separate key for the admin rebuild route, so a leaked game-server key
# cannot trigger index rebuilds (Spec.md §6).
ADMIN_API_KEY=local-dev-admin-key-not-for-production

# --- Optional ---------------------------------------------------------------
# Redis — derived rank index. If unset the service starts and serves in
# DEGRADED mode via the Postgres fallback (Spec.md §4 /health, D2).
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
OUTBOX_SWEEP_INTERVAL_S=5

# Set to 0 when connecting through a PgBouncer-style transaction-mode pooler
# (e.g. a DigitalOcean connection pool): prepared statements do not survive a
# pooled connection being handed to another client (Spec.md §8).
DB_STATEMENT_CACHE_SIZE=100
